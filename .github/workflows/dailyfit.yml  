
name: DailyFit Automatic Daily Records

on:
  schedule:
    - cron: "0 0 * * *"
      timezone: "Asia/Kolkata"

  workflow_dispatch:
    inputs:
      dry_run:
        description: "Test without writing to Firebase"
        type: boolean
        default: true
      max_users:
        description: "Maximum users"
        type: number
        default: 2

permissions:
  contents: read

concurrency:
  group: dailyfit-daily-records
  cancel-in-progress: false

jobs:
  create-daily-records:
    runs-on: ubuntu-latest
    timeout-minutes: 30

    env:
      FIREBASE_CREDENTIALS: ${{ secrets.FIREBASE_CREDENTIALS }}
      DRY_RUN: ${{ github.event_name == 'schedule' && 'false' || inputs.dry_run }}
      MAX_USERS: ${{ github.event_name == 'schedule' && '1000' || inputs.max_users }}

    steps:
      - name: Download code
        uses: actions/checkout@v4

      - name: Setup Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.11"

      - name: Install Firebase Admin SDK
        run: pip install firebase-admin

      - name: Run DailyFit Job
        run: python daily_create.py
